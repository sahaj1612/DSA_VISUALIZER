<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Tree Visualizer</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link rel="stylesheet" href="/css/tree.css">
</head>
<body>
  <div class="app-shell">
    <header class="app-header">
      <h1>DSA Visualizer — Trees</h1>
      <p class="subtitle">General Tree · BST · AVL · B-Tree · Trie</p>
      <div class="view-tabs" role="tablist" aria-label="Tree types">
        <button class="tab-btn active" data-view="general">General Tree</button>
        <button class="tab-btn" data-view="bst">BST</button>
        <button class="tab-btn" data-view="avl">AVL</button>
        <button class="tab-btn" data-view="btree">B-Tree</button>
        <button class="tab-btn" data-view="trie">Trie</button>
      </div>
    </header>

    <main class="app-main">
      <!-- GENERAL TREE -->
      <section class="card tree-view" id="view-general">
        <div class="card-header">
          <h2>General Tree</h2>
          <span class="badge">Root-based</span>
        </div>

        <div class="controls-row">
          <div class="input-group">
            <label for="gt-value">Value</label>
            <input id="gt-value" type="text" placeholder="node value">
          </div>

          <div class="input-group">
            <label for="gt-parent">Parent ID (optional)</label>
            <input id="gt-parent" type="text" placeholder="leave blank to attach to root">
          </div>

          <div class="btn-group">
            <button id="gt-insert" class="btn primary">Insert</button>
            <button id="gt-delete" class="btn danger">Delete</button>
            <button id="gt-reset" class="btn subtle">Reset</button>
            <button id="gt-traverse" class="btn">Preorder</button>
          </div>
        </div>

        <div id="gt-status" class="status-row">Ready.</div>
        <div id="gt-tree" class="tree-area"></div>
      </section>

      <!-- BST -->
      <section class="card tree-view hidden" id="view-bst">
        <div class="card-header">
          <h2>Binary Search Tree</h2>
          <span class="badge">Left & Right</span>
        </div>

        <div class="controls-row">
          <div class="input-group">
            <label for="bst-value">Value</label>
            <input id="bst-value" type="number" placeholder="number">
          </div>

          <div class="btn-group">
            <button id="bst-insert" class="btn primary">Insert</button>
            <button id="bst-delete" class="btn danger">Delete</button>
            <button id="bst-search" class="btn">Search</button>
            <button id="bst-traverse" class="btn">In-order</button>
            <button id="bst-reset" class="btn subtle">Reset</button>
          </div>
        </div>

        <div id="bst-status" class="status-row">Ready.</div>
        <div id="bst-tree" class="tree-area"></div>
      </section>

      <!-- AVL -->
      <section class="card tree-view hidden" id="view-avl">
        <div class="card-header">
          <h2>AVL Tree</h2>
          <span class="badge">Balanced</span>
        </div>

        <div class="controls-row">
          <div class="input-group">
            <label for="avl-value">Value</label>
            <input id="avl-value" type="number" placeholder="number">
          </div>

          <div class="btn-group">
            <button id="avl-insert" class="btn primary">Insert</button>
            <button id="avl-delete" class="btn danger">Delete</button>
            <button id="avl-traverse" class="btn">In-order</button>
            <button id="avl-reset" class="btn subtle">Reset</button>
          </div>
        </div>

        <div id="avl-status" class="status-row">Ready.</div>
        <div id="avl-tree" class="tree-area"></div>
      </section>

      <!-- B-TREE -->
      <section class="card tree-view hidden" id="view-btree">
        <div class="card-header">
          <h2>B-Tree (min degree 2)</h2>
          <span class="badge">Nodes have multiple keys</span>
        </div>

        <div class="controls-row">
          <div class="input-group">
            <label for="bt-value">Value</label>
            <input id="bt-value" type="number" placeholder="number">
          </div>

          <div class="btn-group">
            <button id="bt-insert" class="btn primary">Insert</button>
            <button id="bt-traverse" class="btn">Show keys</button>
            <button id="bt-reset" class="btn subtle">Reset</button>
          </div>
        </div>

        <div id="bt-status" class="status-row">Ready.</div>
        <div id="bt-tree" class="tree-area"></div>
      </section>

      <!-- TRIE -->
      <section class="card tree-view hidden" id="view-trie">
        <div class="card-header">
          <h2>Trie</h2>
          <span class="badge">Prefix Tree</span>
        </div>

        <div class="controls-row">
          <div class="input-group">
            <label for="trie-word">Word</label>
            <input id="trie-word" type="text" placeholder="word">
          </div>

          <div class="btn-group">
            <button id="trie-insert" class="btn primary">Insert</button>
            <button id="trie-search" class="btn">Search</button>
            <button id="trie-prefix" class="btn">StartsWith</button>
            <button id="trie-reset" class="btn subtle">Reset</button>
          </div>
        </div>

        <div id="trie-status" class="status-row">Ready.</div>
        <div id="trie-tree" class="tree-area"></div>
      </section>
    </main>

    <footer class="app-footer">
      <span>Click a tab to switch between tree visualizers. All trees share the same UI/UX.</span>
    </footer>
  </div>

  <script src="/js/tree.js"></script>
</body>
</html>